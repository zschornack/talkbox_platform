   "block": {
    "type": "explanation",
    "label": "PAST SIMPLE · QUICK REVIEW",
    "html": "<b>Past Simple</b> = actions that <b>started and finished</b> in the past.<br>We use it with: <b>yesterday</b> · <b>last</b> night / week / year · two days <b>ago</b> · <b>in</b> 2020.<br><br><b>Regular verbs: + ed</b><br>work → work<b>ed</b> · live → liv<b>ed</b> · study → stud<b>ied</b> · stop → stop<b>ped</b><br><br><b>Irregular verbs</b> have their own form: go → <b>went</b> · buy → <b>bought</b> (see the table)."
   }
  },
  {
   "key": "ps-table",
   "title": "Past Simple · how to use (affirmative, negative, question)",
   "tags": {
    "content": [
     "Past Simple"
    ],
    "levels": [
     "A2"
    ],
    "skills": [
     "Leitura"
    ]
   },
   "block": {
    "type": "table",
    "label": "HOW TO USE",
    "header": true,
    "rows": [
     [
      "FORM",
      "STRUCTURE",
      "EXAMPLE"
     ],
     [
      "<b>Affirmative</b>",
      "subject + verb in the past",
      "I <b>worked</b> yesterday. She <b>went</b> to the beach."
     ],
     [
      "<b>Negative</b>",
      "subject + <b>didn't</b> + base verb",
      "I <b>didn't work</b>. She <b>didn't go</b>."
     ],
     [
      "<b>Question</b>",
      "<b>Did</b> + subject + base verb?",
      "<b>Did</b> you <b>work</b>? Where <b>did</b> she <b>go</b>?"
     ],
     [
      "<b>Short answers</b>",
      "Yes, … did. / No, … didn't.",
      "Did you like it? Yes, I <b>did</b>. / No, I <b>didn't</b>."
     ],
     [
      "<b>To be</b>",
      "I / he / she / it <b>was</b> · you / we / they <b>were</b>",
      "I <b>was</b> tired. They <b>weren't</b> at home."
     ]
    ]
   }
  },
