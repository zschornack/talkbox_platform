            "entre (dois)",
            "The café is <b>between</b> the bank and the bakery."
          ],
          [
            "<b>in front of</b>",
            "na frente de",
            "The car is <b>in front of</b> the house."
          ],
          [
            "<b>behind</b>",
            "atrás de",
            "The garden is <b>behind</b> the house."
          ],
          [
            "<b>opposite</b>",
            "em frente a (do outro lado)",
            "The school is <b>opposite</b> the park."
          ],
          [
            "<b>near</b>",
            "perto de",
            "I live <b>near</b> the beach."
          ],
          [
